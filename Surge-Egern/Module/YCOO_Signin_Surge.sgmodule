#!name=源论坛签到（午夜确认 + 中午补签）
#!desc=午夜签到后通过星币流水确认结果；若当日未确认，12:00仅再尝试一次。Cookie保存在Surge本地，不上传。
#!author=Szt416; Surge adaptation
#!version=2.5-surge.1
#!homepage=https://github.com/szt416/Rules
#!icon=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/icons/YCOO.png
#!arguments=HOUR:23,MINUTE:59,ENABLE_CAPTURE:false
#!arguments-desc=HOUR/MINUTE：午夜前预取时间，默认23:59；ENABLE_CAPTURE：登录后临时设为true并访问源论坛签到页，保存Cookie后改回false。

# 使用前：把配套 YCOO_Signin_Surge.js 上传到下方脚本地址，再安装/更新本模块。
# 本模块不会读取或上传Cookie；Cookie只存储在Surge本地。
[Script]
源论坛 Cookie 获取 = type=http-response, pattern=^https://(?:www\.)?ycoo\.net/k_misign-sign\.html(?:\?.*)?$, script-path=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/Scripts/YCOO/YCOO_Signin_Surge.js, requires-body=false, timeout=15, argument="ENABLE_CAPTURE={{{ENABLE_CAPTURE}}}"
源论坛签到（午夜） = type=cron, cronexp="{{{MINUTE}}} {{{HOUR}}} * * *", script-path=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/Scripts/YCOO/YCOO_Signin_Surge.js, timeout=240, wake-system=true, argument="MODE=checkin"
源论坛签到（中午补签） = type=cron, cronexp="0 12 * * *", script-path=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/Scripts/YCOO/YCOO_Signin_Surge.js, timeout=90, wake-system=true, argument="MODE=noon"

[MITM]
hostname = %APPEND% ycoo.net, www.ycoo.net
