#!name=Telegram 跳转（IBL3ND Surge 适配）
#!desc=基于 IBL3ND/module 的 Egern 版本，仅适配 Surge 接口。默认 Regram（regram://）。测试时请停用其他 Telegram 重定向模块。
#!arguments=CLIENT:Regram
#!arguments-desc=客户端名称：Telegram、Nagram、Swiftgram、Turrit、iMe、Nicegram、Lingogram、Regram。Telegram 表示放行原网页。

[Script]
Telegram-IBL3ND = type=http-request, pattern=^https?://(?:t\.me|telegram\.me)/.+, script-path=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/Scripts/Telegram/Telegram302(Surge).js?v=1, timeout=10, requires-body=false, argument=CLIENT={{CLIENT}}

[MITM]
hostname = %APPEND% t.me, telegram.me
