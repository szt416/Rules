#!name=Telegram 重定向（Surge 响应版）
#!desc=响应阶段 307 重定向，默认 Regram（rg）。需先上传配套 Surge 响应版脚本；请停用旧 Telegram 重定向模块。
#!arguments=app:rg
#!arguments-desc=客户端 Scheme：rg（Regram）、tg、sg、turrit、ime、ng、lingo。默认 rg。

[Script]
Telegram302-Response = type=http-response, pattern=^https?://(?:t\.me|telegram\.me|telegram\.dog)(?::(?:80|443))?/, script-path=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/Scripts/Telegram/Telegram302(Surge).js?v=response307-1, timeout=5, requires-body=false, argument=app={{app}}

[MITM]
hostname = %APPEND% t.me, telegram.me, telegram.dog
