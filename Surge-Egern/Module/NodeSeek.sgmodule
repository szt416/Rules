#!name=NodeSeek签到（Szt16）
#!desc=访问已登录账号的个人资料页保存 Cookie，每天 00:10 签到。使用远程脚本，支持 Cookie 抓取开关及随机/固定奖励。
#!author=基于 Szt416 / Roddy-D 上游适配
#!homepage=https://github.com/szt416/Rules
#!arguments=ENABLE_CAPTURE:true,RANDOM_REWARD:true
#!arguments-desc=ENABLE_CAPTURE：true 开启 Cookie 抓取，false 关闭；获取成功后建议关闭。RANDOM_REWARD：true 随机奖励，false 固定奖励。关闭抓取不影响使用已保存的 Cookie 签到。

[Script]
NodeSeek Cookie 获取 = type=http-request,pattern=^https://www\.nodeseek\.com/api/account/getInfo/\d+(?:\?.*)?$,script-path=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/Scripts/NodeSeek/Nodeseek(Surge).js,timeout=10,argument="capture={{{ENABLE_CAPTURE}}}"
NodeSeek 自动签到 = type=cron,cronexp="10 0 * * *",script-path=https://raw.githubusercontent.com/szt416/Rules/refs/heads/main/Surge-Egern/Scripts/NodeSeek/Nodeseek(Surge).js,timeout=30,wake-system=1,argument="random={{{RANDOM_REWARD}}}"

[MITM]
hostname = %APPEND% www.nodeseek.com
